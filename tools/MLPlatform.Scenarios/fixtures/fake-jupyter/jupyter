#!/usr/bin/env python3
# Fake Jupyter for the M08 scenario (test image only): accepts the exact arguments the platform passes to `jupyter lab`, checks the token,
# serves GET {base}api/status (lists home), PUT {base}api/contents/<name> (writes a file into home), WebSocket {base}api/ws (echo).
import base64, hashlib, http.server, json, os, socketserver, struct, sys

args = dict(a[2:].split("=", 1) for a in sys.argv[2:] if a.startswith("--") and "=" in a)
PORT = int(args.get("port", "8888")); BASE = args.get("ServerApp.base_url", "/"); TOKEN = args.get("IdentityProvider.token", "")
HOME = args.get("ServerApp.root_dir", "/home/mlp")
os.makedirs(HOME, exist_ok=True)

class H(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *a): pass
    def authed(self):
        if self.headers.get("Authorization") != "token " + TOKEN:
            self.reply(403, {"error": "token"}); return False
        return True
    def reply(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        if not self.authed(): return
        if self.path == BASE + "api/status":
            return self.reply(200, {"ok": True, "home": sorted(os.listdir(HOME)), "base": BASE})
        if self.path == BASE + "api/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
            return self.websocket()
        self.reply(404, {"error": self.path})
    def do_PUT(self):
        if not self.authed(): return
        name = self.path[len(BASE + "api/contents/"):]
        data = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        with open(os.path.join(HOME, os.path.basename(name)), "wb") as f: f.write(data)
        self.reply(201, {"saved": name, "bytes": len(data)})
    def websocket(self):
        key = self.headers["Sec-WebSocket-Key"]
        acc = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        self.send_response(101); self.send_header("Upgrade", "websocket"); self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", acc); self.end_headers(); self.wfile.flush()
        while True:
            hdr = self.rfile.read(2)
            if len(hdr) < 2: return
            op, n = hdr[0] & 0x0F, hdr[1] & 0x7F
            if n == 126: n = struct.unpack(">H", self.rfile.read(2))[0]
            elif n == 127: n = struct.unpack(">Q", self.rfile.read(8))[0]
            mask = self.rfile.read(4) if hdr[1] & 0x80 else b"\0\0\0\0"
            data = bytes(b ^ mask[i % 4] for i, b in enumerate(self.rfile.read(n)))
            if op == 8:
                self.wfile.write(b"\x88\x00"); self.wfile.flush(); return
            out = bytes([0x80 | op]) + (bytes([len(data)]) if len(data) < 126 else b"\x7e" + struct.pack(">H", len(data))) + data
            self.wfile.write(out); self.wfile.flush()

class S(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True

S(("0.0.0.0", PORT), H).serve_forever()
