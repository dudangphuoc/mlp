# ── MLPlatform (compose.yaml). cp .env.example .env, then fill in. Infrastructure (PostgreSQL, MinIO) is external — not run in the stack. ──
MLP_VERSION=dev                       # tag image api/web/agent-builder
MLP_IMAGE_PREFIX=mlp                  # e.g. ghcr.io/<org>/mlp
MLP_NETWORK=mlp                       # docker network (workload containers join the same network)

# Public addresses — must be reachable from browsers and agent machines
MLP_PUBLIC_URL=http://localhost:8080  # web URL (also serves /install/agent.sh)
MLP_AGENT_ADDRESS=localhost:7443      # host:port of the TLS agent channel
MLP_WG_ENDPOINT=mlp.example.com:51820 # UDP host:port of the WireGuard overlay hub

# Ports exposed on the host
MLP_WEB_PORT=8080
MLP_API_GRPC_PORT=5080
MLP_AGENT_PORT=7443
MLP_WG_PORT=51820

# Admin account — the api creates it if it doesn't exist
MLP_ADMIN_EMAIL=admin@example.com
MLP_ADMIN_PASSWORD=change-me-right-now
MLP_ADMIN_NAME=Admin

# Secrets (openssl rand -hex 24)
MLP_TOKEN_PEPPER=change-me
MLP_AGENT_CERT_PASSWORD=change-me

# PostgreSQL (dedicated database, user with CREATE privilege)
MLP_DB_CONNECTION=Host=pg.example;Port=5432;Database=mlp;Username=mlp;Password=change-me

# MinIO / S3 — the api creates the buckets if they don't exist
MLP_S3_ENDPOINT=http://minio.example:9000   # used by the api
MLP_S3_PUBLIC_URL=https://s3.example.com    # browsers / agents download via signed URLs
MLP_S3_ACCESS_KEY=
MLP_S3_SECRET_KEY=
MLP_S3_REGION=us-east-1
MLP_S3_DATASETS_BUCKET=mlp-datasets
MLP_S3_ARTIFACTS_BUCKET=mlp-artifacts

# agent-builder: RIDs to prebuild (space-separated), max CPUs
MLP_AGENT_PREBUILD=linux-x64
MLP_BUILDER_CPUS=2

# Email / Telegram: configure in the UI (Settings → System), not here.
OTEL_EXPORTER_OTLP_ENDPOINT=

# WireGuard overlay: hub in this stack (default) or on k8s (deploy/k8s/mlp-net-hub.yaml) → the stack is a spoke
MLP_WG_MODE=hub                       # hub | spoke
MLP_OVERLAY_IP=10.88.0.1              # spoke: 10.88.255.1
MLP_WG_HUB_PUB=                       # spoke: the hub's public key
MLP_WG_HUB_KEYFILE=/net/hub.pub       # spoke: leave empty
MLP_WG_MTU=1380                       # hub behind another tunnel: 1300
MLP_WG_PEERS_TOKEN=                   # a k8s hub pulls the peer list with this token
# Public subdomains for notebooks / deployments (deploy/k8s/mlp-routes.yaml)
MLP_ROUTES_DOMAIN=
