<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <AssemblyName>mlp-shim</AssemblyName>
    <!-- LibraryImport of libc link() (hard links for the dataset cache views) generates unsafe marshalling code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Framework/MLPlatform.Recipes/MLPlatform.Recipes.csproj" />
    <ProjectReference Include="../../Framework/MLPlatform.Contracts/MLPlatform.Contracts.csproj" />
  </ItemGroup>
</Project>
